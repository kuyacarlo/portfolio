---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="note-tag-filter" role="group" aria-label="Filter by tag">
  <span class="tag-filter-label">tags</span>
  <button type="button" data-tag-filter="all" aria-pressed="true">all tags</button>
  {tags.map((tag) => <button type="button" data-tag-filter={tag} aria-pressed="false">{tag}</button>)}
</div>

<style>
  .note-tag-filter { display: flex; flex-wrap: wrap; align-items: stretch; border-bottom: var(--rule); }
  .tag-filter-label { display: flex; align-items: center; padding: 0 var(--gutter); color: var(--muted); font: var(--type-label); text-transform: uppercase; }
  button { flex: none; min-height: 48px; padding: 0 16px; border: 0; border-left: var(--rule); background: var(--paper); color: var(--ink); font: 400 13px/1 var(--font-mono); }
  button:hover { text-decoration: underline; text-underline-offset: 3px; }
  button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  button:focus-visible { outline-offset: -6px; }
  button[aria-pressed="true"]:focus-visible { outline-color: var(--paper); }
  @media (max-width: 767px) {
    .note-tag-filter { flex-wrap: nowrap; overflow-x: auto; }
    .tag-filter-label { flex: none; }
  }
</style>
