---
// NoteLayout — extends Layout.astro with:
//   • KaTeX CSS     (server-rendered math from rehype-katex)
//   • Mermaid.js    (client-side, converts ```mermaid blocks)
//   • CircuiTikZ    (server-rendered SVG via node-tikzjax / remark-tikz)
import Layout from './Layout.astro';
interface Props {
  title?: string;
  description?: string;
  hasMath?: boolean;
  hasTikz?: boolean;
  hasMermaid?: boolean;
}
const {
  title,
  description,
  hasMath = false,
  hasTikz = false,
  hasMermaid = false,
} = Astro.props;
---

<Layout title={title} description={description} active="notes">
  {hasMath && (
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5"
      crossorigin="anonymous"
      slot="head"
    />
  )}
  {hasTikz && (
    <link rel="stylesheet" href="https://tikzjax.com/v1/fonts.css" slot="head" />
  )}

  <slot />

  {hasMermaid && (
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: 'Red Hat Mono, monospace',
        themeVariables: {
          background: '#ffffff',
          primaryColor: '#f2f2f2',
          primaryBorderColor: '#000000',
          primaryTextColor: '#000000',
          lineColor: '#000000',
          edgeLabelBackground: '#ffffff',
          clusterBkg: '#f2f2f2',
          fontFamily: 'Red Hat Text, sans-serif',
        },
      });

      document.addEventListener('DOMContentLoaded', async () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"] code, pre code.language-mermaid');
        for (const block of blocks) {
          const pre = block.closest('pre');
          const code = block.textContent || '';
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code;
          pre?.replaceWith(div);
        }
        await mermaid.run({ querySelector: '.mermaid' });
      });
    </script>
  )}
</Layout>

<style is:global>
  .math-display { overflow-x: auto; padding: 16px 0; }
  .katex-display { margin: 0; }

  .mermaid { background: var(--surface); border: var(--rule); padding: 24px; margin-bottom: 24px; overflow-x: auto; text-align: center; }
  .mermaid svg { max-width: 100%; height: auto; }

  .tikz-figure {
    display: flex;
    justify-content: center;
    margin: 24px 0;
    padding: 20px;
    background: var(--surface);
    border: var(--rule);
    overflow-x: auto;
    contain: paint;
  }
  .tikz-figure img,
  .tikz-figure svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .tikz-error {
    background: var(--surface);
    border: var(--rule);
    padding: 14px 16px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    margin-bottom: 18px;
    white-space: pre-wrap;
  }

  .note-article .body pre.astro-code { border: var(--rule); padding: 16px; overflow-x: auto; font: var(--type-code); margin-bottom: 24px; background: var(--surface) !important; }
</style>
