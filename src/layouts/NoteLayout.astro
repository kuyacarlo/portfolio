---
// NoteLayout — extends Layout.astro with:
//   • KaTeX CSS     (server-rendered math from rehype-katex)
//   • Mermaid.js    (client-side, converts ```mermaid blocks)
//   • CircuiTikZ    (server-rendered SVG via node-tikzjax / rehype-tikz)
import Layout from './Layout.astro';
interface Props {
  title?: string;
  description?: string;
  /** Short title shown in the sticky note nav after scroll */
  noteTitle?: string;
  hasMath?: boolean;
  hasTikz?: boolean;
  hasMermaid?: boolean;
}
const {
  title,
  description,
  noteTitle = "",
  hasMath = false,
  hasTikz = false,
  hasMermaid = false,
} = Astro.props;
---

<Layout title={title} description={description} active="notes" noteTitle={noteTitle}>
  {hasMath && (
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5"
      crossorigin="anonymous"
      slot="head"
    />
  )}
  {hasTikz && (
    <link rel="stylesheet" href="https://tikzjax.com/v1/fonts.css" slot="head" />
  )}

  <slot />

  {hasMermaid && (
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        darkMode: true,
        fontFamily: 'JetBrains Mono, monospace',
        themeVariables: {
          background:    '#141312',
          primaryColor:  '#252320',
          primaryBorderColor: '#363430',
          primaryTextColor:   '#f0ede6',
          lineColor:     '#4a4844',
          edgeLabelBackground: '#141312',
          clusterBkg:    '#1d1c1a',
        },
      });

      document.addEventListener('DOMContentLoaded', async () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"] code, pre code.language-mermaid');
        for (const block of blocks) {
          const pre = block.closest('pre');
          const code = block.textContent || '';
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code;
          pre?.replaceWith(div);
        }
        await mermaid.run({ querySelector: '.mermaid' });
      });
    </script>
  )}
</Layout>

<style is:global>
  .math-display { overflow-x: auto; padding: 16px 0; }
  .katex-display { margin: 0; }

  .mermaid {
    background: var(--s1);
    border: 1px solid var(--b1);
    border-radius: 6px;
    padding: 24px;
    margin-bottom: 18px;
    overflow-x: auto;
    text-align: center;
  }
  .mermaid svg { max-width: 100%; height: auto; }

  /* Circuit figures: muted paper, not pure white — avoids high-contrast
     flashes when Astro HMR remounts the note body during edits. */
  .tikz-figure {
    display: flex;
    justify-content: center;
    margin: 24px 0;
    padding: 20px;
    background: #e8e4dc;
    border-radius: 6px;
    border: 1px solid var(--b1);
    overflow-x: auto;
    contain: paint;
  }
  .tikz-figure img,
  .tikz-figure svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .tikz-figure {
      transition: none;
    }
  }
  .tikz-error {
    background: var(--s1);
    border: 1px solid var(--b1);
    border-radius: 6px;
    padding: 14px 16px;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.78rem;
    margin-bottom: 18px;
    white-space: pre-wrap;
  }

  .note-article .body pre.astro-code {
    border: 1px solid var(--b1);
    border-radius: 6px;
    padding: 20px 22px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.7;
    margin-bottom: 18px;
    background: var(--s1) !important;
  }
</style>
