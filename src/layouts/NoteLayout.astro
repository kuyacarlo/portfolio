---
// NoteLayout — extends Layout.astro with:
//   • KaTeX CSS     (server-rendered math from rehype-katex)
//   • Mermaid.js    (client-side, converts ```mermaid blocks)
//   • TikZJax       (client-side WASM, renders ```tikz / CircuiTikZ blocks)
import Layout from './Layout.astro';
interface Props {
  title?: string;
  description?: string;
  hasMath?: boolean;
  hasTikz?: boolean;
  hasMermaid?: boolean;
}
const { title, description, hasMath = false, hasTikz = false, hasMermaid = false } = Astro.props;
---

<Layout title={title} description={description} active="notes">
  {hasMath && (
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5"
      crossorigin="anonymous"
      slot="head"
    />
  )}
  {hasTikz && (
    <link rel="stylesheet" href="https://tikzjax.com/v1/fonts.css" slot="head" />
  )}

  <slot />

  {hasMermaid && (
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        darkMode: true,
        fontFamily: 'JetBrains Mono, monospace',
        themeVariables: {
          background:    '#141312',
          primaryColor:  '#252320',
          primaryBorderColor: '#363430',
          primaryTextColor:   '#f0ede6',
          lineColor:     '#4a4844',
          edgeLabelBackground: '#141312',
          clusterBkg:    '#1d1c1a',
        },
      });

      document.addEventListener('DOMContentLoaded', async () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"] code, pre code.language-mermaid');
        for (const block of blocks) {
          const pre = block.closest('pre');
          const code = block.textContent || '';
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code;
          pre?.replaceWith(div);
        }
        await mermaid.run({ querySelector: '.mermaid' });
      });
    </script>
  )}

  {hasTikz && (
    <script is:inline>
      // Lazy-load TikZJax only when the page actually has tikz scripts
      if (document.querySelector('script[type="text/tikz"]')) {
        const s = document.createElement('script');
        s.src = 'https://tikzjax.com/v1/tikzjax.js';
        s.async = true;
        document.head.appendChild(s);
      }
    </script>
  )}
</Layout>

<style is:global>
  /* ── KaTeX display math centering ────────────────────────────────────────── */
  .math-display { overflow-x: auto; padding: 16px 0; }
  .katex-display { margin: 0; }

  /* ── Mermaid diagram container ────────────────────────────────────────────── */
  .mermaid {
    background: var(--s1);
    border: 1px solid var(--b1);
    border-radius: 6px;
    padding: 24px;
    margin-bottom: 18px;
    overflow-x: auto;
    text-align: center;
  }
  .mermaid svg { max-width: 100%; height: auto; }

  /* ── TikZJax output ──────────────────────────────────────────────────────── */
  svg[id^="tikzjax"] {
    display: block;
    margin: 24px auto;
    background: #fff;           /* TikZ renders on white */
    border-radius: 6px;
    padding: 16px;
    max-width: 100%;
  }

  /* ── Shiki code block overrides ───────────────────────────────────────────── */
  .note-article .body pre.astro-code {
    border: 1px solid var(--b1);
    border-radius: 6px;
    padding: 20px 22px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.7;
    margin-bottom: 18px;
    background: var(--s1) !important;
  }
</style>
