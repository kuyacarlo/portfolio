---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = 'John Carlo Santos — Software and Systems Engineer',
  description = 'Software and systems engineer. ETL pipelines, DevSecOps guardrails, agent harnesses. Open to data and DevOps roles.',
  active = '',
} = Astro.props;

const links = [
  { href: '/homelab', label: 'homelab', key: 'homelab' },
  { href: '/notes', label: 'notes', key: 'notes' },
  { href: '/certs', label: 'certs', key: 'certs' },
  { href: '/resume', label: 'resume', key: 'resume' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="John Carlo Santos" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="John Carlo Santos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://kuyacarlo.dev')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400..900&family=Red+Hat+Text:wght@400..700&family=Red+Hat+Mono:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'%3E%3Cpath fill='%23000' d='M2 30h5v-5h5v-5h5v-5h5v-5h5V5h7v26H2z'/%3E%3C/svg%3E" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <header class="site-header">
        <a href="/" class="brand" aria-label="kuyacarlo home">
          <Mark class="brand-mark" />
          <span>kuyacarlo</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {links.map((link) => <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <a href="/book" class="talk-link" aria-current={active === 'book' ? 'page' : undefined}>Let’s talk</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
      </header>
      <nav id="mobile-menu" class="mobile-menu" aria-label="Main mobile" hidden>
        {links.map((link) => <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
        <a href="/book" class="mobile-talk" aria-current={active === 'book' ? 'page' : undefined}>Let’s talk →</a>
      </nav>
      <slot />
      <Footer><slot name="footer" /></Footer>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-menu');
      const closeMenu = () => {
        if (!button || !menu) return;
        button.setAttribute('aria-expanded', 'false');
        button.textContent = 'Menu';
        menu.hidden = true;
      };
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        button.textContent = open ? 'Close' : 'Menu';
        if (menu) menu.hidden = !open;
      });
      menu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeMenu();
      });
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          button.focus();
        }
      });
    </script>
  </body>
</html>
