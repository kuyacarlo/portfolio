---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "John Carlo Santos",
  description = "BS Computer Engineering @ BulSU. Data engineer, DevOps tinkerer, hackathon builder. Bulacan, PH.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="John Carlo Santos" />
  <link rel="canonical" href="https://kuyacarlo.dev" />
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23111110'/%3E%3Ctext x='50%25' y='56%25' dominant-baseline='middle' text-anchor='middle' font-size='14' font-family='monospace' fill='%23e8e6e1'%3Ejk%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <slot />

  <script>
    // Scroll reveal
    const io = new IntersectionObserver(
      es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } }),
      { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    // Typing effect
    document.querySelectorAll<HTMLElement>('[data-type]').forEach(el => {
      const words = (el.dataset.type || '').split('|');
      let wi = 0, ci = 0, del = false;
      const tick = () => {
        const w = words[wi];
        el.textContent = del ? w.slice(0, ci--) : w.slice(0, ci++);
        let t = del ? 50 : 95;
        if (!del && ci > w.length)  { t = 1800; del = true; }
        if (del  && ci < 0)         { del = false; wi = (wi+1)%words.length; ci = 0; t = 350; }
        setTimeout(tick, t);
      };
      setTimeout(tick, 800);
    });
  </script>
</body>
</html>
