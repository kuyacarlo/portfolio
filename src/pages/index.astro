---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import projectContent from '../data/projects.json';
import hackathonContent from '../data/hackathons.json';
import nowContent from '../data/now.json';
import layers from '../data/layers.json';

const layerName = (n: number) => layers.find((layer) => layer.n === n)?.name ?? '';
const coverageLabel = (values: number[]) => `Layers: ${values.map(layerName).filter(Boolean).join(', ')}`;
const projects = projectContent.projects.map((project) => {
  const links = project.links as { source?: string; live?: string; internal?: string };
  return { ...project, source: links.source, live: links.live, internal: links.internal };
});
const phoneProjects = projects.filter((project) => project.featuredOnPhone);
const podiums = hackathonContent.filter((item) => item.podium);
const otherCompetitions = hackathonContent.filter((item) => !item.podium);
---

<Layout active="home" title="John Carlo Santos — Software & Systems Engineer" description="I build software across data, infrastructure, and the people who use it.">
  <main id="main" class="stack-home">
    <div class="shell">
      <section class="page page-hero home-hero" aria-labelledby="home-title">
        <div class="home-intro">
          <p class="eyebrow">AVAILABLE — HACKATHON TEAMS, DATA AND DEVOPS ROLES</p>
          <h1 id="home-title">Solder, servers,<br />and the people<br class="hero-break" /> in between.</h1>
          <div class="hero-copy">
            <p>I’m John Carlo Santos, a software and systems engineer and CTO at Seekers Guild. I study Computer Engineering at Bulacan State University.</p>
            <p>I build dependable data systems, developer tooling, and agent workflows. I care about how the pieces meet the people using them.</p>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">SEE THE WORK</a>
            <a class="button button-secondary" href="/resume">RESUME</a>
          </div>
        </div>
        <div class="hero-layers" aria-label="Layers of work">
          {layers.map((layer) => (
            <div class="hero-layer">
              <span class="badge layer-badge">{String(layer.n).padStart(2, '0')}</span>
              <span>{layer.name}</span>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- PROJECTS -->
    <section id="work" class="page-section" aria-labelledby="work-title">
      <div class="shell">
        <div class="section-heading">
          <h2 class="section-title" id="work-title">01 Selected work</h2>
          <a class="text-link" href="/resume">FULL RESUME →</a>
        </div>

        <div class="desktop-projects" role="region" aria-label="Selected projects">
          <div class="data-table project-table" role="table" aria-label="Selected work">
            <div class="table-row table-head" role="row">
              <span role="columnheader">PROJECT</span>
              <span role="columnheader">WHAT IT IS</span>
              <span role="columnheader">01—06</span>
              <span role="columnheader">LINKS</span>
            </div>
            {projects.map((project) => (
              <div class="table-row project-row" role="row">
                <strong role="cell">{project.name}</strong>
                <span role="cell">{project.description}</span>
                <span class="coverage" role="img" aria-label={coverageLabel(project.layers)}>
                  {layers.map((layer) => <span class:list={["coverage-cell", { filled: project.layers.includes(layer.n) }]} aria-hidden="true"></span>)}
                </span>
                <span class="project-links" role="cell">
                  {project.source && <a href={project.source} target="_blank" rel="noopener noreferrer">SOURCE</a>}
                  {project.live && <a href={project.live} target="_blank" rel="noopener noreferrer">LIVE</a>}
                  {project.internal && <a href={project.internal}>HOMELAB</a>}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="phone-projects" data-phone-projects>
          <div class="phone-project-list">
            {phoneProjects.map((project) => (
              <article class="cell phone-project-card">
                <div class="phone-project-title">
                  <h3>{project.name}</h3>
                  {project.source && <a href={project.source} target="_blank" rel="noopener noreferrer" aria-label={`Source for ${project.name}`}>SOURCE →</a>}
                  {project.live && <a href={project.live} target="_blank" rel="noopener noreferrer" aria-label={`Live ${project.name}`}>LIVE →</a>}
                  {project.internal && <a href={project.internal} aria-label={`About ${project.name}`}>OPEN →</a>}
                </div>
                <p>{project.description}</p>
                <span class="coverage" role="img" aria-label={coverageLabel(project.layers)}>
                  {layers.map((layer) => <span class:list={["coverage-cell", { filled: project.layers.includes(layer.n) }]} aria-hidden="true"></span>)}
                </span>
              </article>
            ))}
            {projects.filter((project) => !project.featuredOnPhone).map((project) => (
              <article class="cell phone-project-card phone-project-extra" hidden>
                <div class="phone-project-title">
                  <h3>{project.name}</h3>
                  {project.source && <a href={project.source} target="_blank" rel="noopener noreferrer" aria-label={`Source for ${project.name}`}>SOURCE →</a>}
                  {project.live && <a href={project.live} target="_blank" rel="noopener noreferrer" aria-label={`Live ${project.name}`}>LIVE →</a>}
                </div>
                <p>{project.description}</p>
                <span class="coverage" role="img" aria-label={coverageLabel(project.layers)}>
                  {layers.map((layer) => <span class:list={["coverage-cell", { filled: project.layers.includes(layer.n) }]} aria-hidden="true"></span>)}
                </span>
              </article>
            ))}
          </div>
          <button class="button button-secondary expand-button" type="button" data-expand-projects data-count={projects.length} aria-expanded="false">
            SHOW ALL {projects.length} PROJECTS
          </button>
        </div>
      </div>
    </section>

    <!-- HACKATHONS -->
    <section class="page-section" aria-labelledby="hackathons-title">
      <div class="shell">
        <div class="section-heading">
          <h2 class="section-title" id="hackathons-title">02 Hackathons</h2>
        </div>
        <div class="split hackathon-layout">
          <div class="competition-list" aria-label="Competition results">
            {hackathonContent.map((item) => (
              <div class:list={["result-row", { podium: item.podium }]}>
                <span class="result-place">{item.result}</span>
                <strong>{item.project}</strong>
                <span>{item.event}</span>
              </div>
            ))}
          </div>
          <aside class="stat-pair" aria-label={`${hackathonContent.length} competitions, ${podiums.length} podium finishes`}>
            <div class="stat-cell"><strong>{hackathonContent.length}</strong><span>COMPETITIONS</span></div>
            <div class="stat-cell stat-inverted"><strong>{podiums.length}</strong><span>PODIUMS</span></div>
          </aside>
        </div>
        <div class="phone-competitions" data-phone-competitions>
          <div class="phone-result-list">
            {podiums.map((item) => (
              <article class="cell phone-result-card podium">
                <span class="result-place">{item.result}</span>
                <strong>{item.project}</strong>
                <span>{item.event}</span>
              </article>
            ))}
            {otherCompetitions.map((item) => (
              <article class="cell phone-result-card phone-result-extra" hidden>
                <span class="result-place">{item.result}</span>
                <strong>{item.project}</strong>
                <span>{item.event}</span>
              </article>
            ))}
          </div>
          <button class="button button-secondary expand-button" type="button" data-expand-competitions data-count={hackathonContent.length} aria-expanded="false">
            SHOW ALL {hackathonContent.length} COMPETITIONS
          </button>
        </div>
      </div>
    </section>

    <!-- NOW -->
    <section class="page-section" aria-labelledby="now-title">
      <div class="shell">
        <div class="section-heading"><h2 class="section-title" id="now-title">03 Now</h2></div>
        <div class="now-grid">
          <div class="cell now-cell"><span class="label">BUILDING</span><p>{nowContent.building}</p></div>
          <div class="cell now-cell"><span class="label">LEARNING</span><p>{nowContent.learning}</p></div>
          <div class="cell now-cell"><span class="label">EXPLORING</span><p>{nowContent.exploring}</p></div>
          <div class="cell now-cell"><span class="label">OPEN FOR</span><p>{nowContent.openFor}</p></div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact-section" aria-labelledby="contact-title">
      <div class="shell">
        <div class="section-heading"><h2 class="section-title" id="contact-title">04 Contact</h2></div>
        <div class="contact-panel">
          <div>
            <h2>Pick one.<br />I’ll reply.</h2>
            <p>{nowContent.openFor}</p>
          </div>
          <div class="contact-actions">
            <a class="button button-on-ink" href="/book">BOOK A CALL</a>
            <a class="button button-on-ink-secondary" href={`mailto:${site.email}`}>SEND AN EMAIL</a>
            <div class="social-links" aria-label="Social links">
              <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
              <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a>
              <a href={site.devtoUrl} target="_blank" rel="noopener noreferrer">DEV.TO ↗</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="shell">
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} John Carlo Santos</span>
          <span>{nowContent.tagline}</span>
      </footer>
    </div>
  </main>
</Layout>

<script>
  const expandList = (button: HTMLButtonElement | null, selector: string, label: string) => {
    if (!button) return;
    const count = Number(button.dataset.count ?? 0);
    const items = Array.from(document.querySelectorAll<HTMLElement>(selector));
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      items.forEach((item) => { item.hidden = expanded; });
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? `SHOW ALL ${count} ${label}` : 'SHOW FEWER';
    });
  };

  expandList(document.querySelector<HTMLButtonElement>('[data-expand-projects]'), '.phone-project-extra', 'PROJECTS');
  expandList(document.querySelector<HTMLButtonElement>('[data-expand-competitions]'), '.phone-result-extra', 'COMPETITIONS');
</script>

<style>
  .stack-home { color: var(--ink); }
  .home-hero { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); padding-block: clamp(48px, 9vw, 112px); }
  .home-intro { flex: 999 1 560px; min-width: 0; }
  .home-intro h1 { max-width: 900px; margin: var(--space-3) 0 var(--space-4); font: 900 clamp(44px, 7vw, 104px)/.9 var(--font-display); letter-spacing: -.035em; text-transform: none; }
  .hero-copy { max-width: 700px; font: 400 19px/1.5 var(--font-text); }
  .hero-copy p + p { margin-top: var(--space-2); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .hero-layers { flex: 1 1 320px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--rule); border-left: var(--rule); }
  .hero-layer { min-height: 76px; display: flex; align-items: center; gap: 12px; padding: 10px; border-right: var(--rule); border-bottom: var(--rule); font: 700 15px/1 var(--font-mono); text-transform: uppercase; }
  .layer-badge { width: 48px; height: 48px; display: grid; place-items: center; flex: none; }
  .page-section { padding-block: var(--space-5); border-top: var(--rule); }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-3); }
  .section-title { margin: 0; font: 900 40px/1 var(--font-display); letter-spacing: -.02em; text-transform: uppercase; }
  .text-link, .project-links a, .phone-project-title a, .social-links a { color: var(--link); font: 600 12px/1.4 var(--font-mono); text-decoration: underline; text-underline-offset: 3px; }
  .desktop-projects { display: block; }
  .project-table .table-row { display: grid; grid-template-columns: minmax(170px, 1.2fr) minmax(220px, 2fr) 216px minmax(150px, 1fr); align-items: stretch; }
  .table-head { font: 700 12px/1.4 var(--font-mono); }
  .project-table .table-head > *, .project-row > * { padding: 14px var(--gutter); border-right: var(--rule); border-bottom: var(--rule); }
  .project-table .table-head { border-top: var(--rule); border-left: var(--rule); background: var(--surface); }
  .project-row { border-left: var(--rule); }
  .project-row > :first-child { font: 800 20px/1.15 var(--font-display); }
  .project-row > :nth-child(2) { font: 400 15px/1.5 var(--font-text); }
  .coverage { display: grid; grid-template-columns: repeat(6, 1fr); min-width: 0; height: 48px; border: var(--rule); }
  .project-row .coverage { align-self: center; margin: 0 var(--gutter); height: 36px; }
  .coverage-cell { border-right: var(--rule); background: var(--paper); }
  .coverage-cell:last-child { border-right: 0; }
  .coverage-cell.filled { background: var(--ink); }
  .project-links { display: flex; align-content: center; align-items: center; flex-wrap: wrap; gap: 8px 12px; }
  .phone-projects, .phone-competitions { display: none; }
  .split { display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--space-3); }
  .competition-list { flex: 999 1 560px; border-top: var(--rule); }
  .result-row { min-height: 66px; display: grid; grid-template-columns: 150px minmax(150px, 1fr) minmax(180px, 1.4fr); align-items: center; gap: 16px; padding: 12px var(--gutter); border: var(--rule); border-top: 0; }
  .result-row.podium { color: var(--paper); background: var(--ink); }
  .result-place, .label { font: 700 12px/1.35 var(--font-mono); text-transform: uppercase; }
  .result-row strong { font: 800 22px/1.1 var(--font-display); }
  .result-row > span:last-child { color: var(--muted); font: 400 14px/1.4 var(--font-text); }
  .result-row.podium > span:last-child { color: var(--paper); }
  .stat-pair { flex: 1 1 300px; display: grid; grid-template-columns: 1fr 1fr; align-self: stretch; border-top: var(--rule); border-left: var(--rule); }
  .stat-cell { display: flex; flex-direction: column; justify-content: space-between; min-height: 164px; padding: 16px; border-right: var(--rule); border-bottom: var(--rule); }
  .stat-cell strong { font: 900 clamp(64px, 9vw, 120px)/.8 var(--font-display); letter-spacing: -.06em; }
  .stat-cell span { font: 700 12px/1.2 var(--font-mono); }
  .stat-inverted { color: var(--paper); background: var(--ink); }
  .now-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: var(--rule); border-left: var(--rule); }
  .now-cell { min-height: 160px; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--gutter); border-right: var(--rule); border-bottom: var(--rule); }
  .now-cell p { margin: 0; font: 400 16px/1.55 var(--font-text); }
  .contact-section { padding-block: var(--space-5); color: var(--paper); background: var(--ink); }
  .contact-section .section-heading { border-bottom: 2px solid var(--paper); padding-bottom: 16px; }
  .contact-panel { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-5); padding-block: var(--space-4); }
  .contact-panel > div:first-child { flex: 999 1 560px; }
  .contact-panel h2 { margin: 0 0 var(--space-2); font: 900 clamp(44px, 7vw, 104px)/.9 var(--font-display); letter-spacing: -.035em; }
  .contact-panel p { font: 400 16px/1.5 var(--font-text); }
  .contact-actions { flex: 1 1 300px; display: grid; gap: 12px; }
  .button-on-ink, .button-on-ink-secondary { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; padding: 12px 20px; border: 2px solid var(--paper); color: var(--ink); background: var(--paper); font: 800 15px/1.2 var(--font-display); text-align: center; text-decoration: none; }
  .button-on-ink-secondary { color: var(--paper); background: transparent; }
  .social-links { display: flex; flex-wrap: wrap; gap: 12px 20px; padding-top: 8px; }
  .social-links a { color: var(--paper); }
  .site-footer { min-height: 64px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; border-top: var(--rule); font: 500 12px/1.4 var(--font-mono); }
  .phone-project-list, .phone-result-list { display: grid; }
  .phone-project-card { display: grid; gap: 12px; padding: 16px; border-top: 0; }
  .phone-project-title { display: flex; align-items: start; justify-content: space-between; gap: 8px; }
  .phone-project-title h3 { margin: 0; font: 800 20px/1.1 var(--font-display); }
  .phone-project-card p { margin: 0; font: 400 14px/1.5 var(--font-text); }
  .expand-button { width: 100%; margin-top: 12px; }
  .phone-result-card { display: grid; gap: 6px; padding: 16px; border-top: 0; }
  .phone-result-card strong { font: 800 20px/1.1 var(--font-display); }
  .phone-result-card > span:last-child { color: var(--muted); font: 400 14px/1.4 var(--font-text); }
  .phone-result-card.podium { color: var(--paper); background: var(--ink); }
  .phone-result-card.podium > span:last-child { color: var(--paper); }
  [hidden] { display: none !important; }
  @media (min-width: 768px) and (max-width: 1023px) {
    .project-table .table-row { grid-template-columns: minmax(130px, 1fr) minmax(150px, 1.5fr) minmax(140px, .9fr) minmax(125px, .8fr); }
    .project-table .table-head > *, .project-row > * { padding-inline: 10px; }
    .project-row .coverage { margin-inline: 10px; }
  }
  @media (max-width: 767px) {
    .home-hero { gap: var(--space-4); padding-block: 48px; }
    .home-intro h1 { margin-block: 20px; font-size: 46px; }
    .hero-copy { font-size: 16px; }
    .hero-break { display: none; }
    .hero-layers { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
    .hero-layer { min-height: 64px; justify-content: center; flex-direction: column; gap: 6px; padding: 6px 2px; font-size: 9px; }
    .layer-badge { width: 36px; height: 36px; }
    .section-title { font-size: 28px; }
    .desktop-projects { display: none; }
    .phone-projects, .phone-competitions { display: block; }
    .phone-project-card:first-child, .phone-result-card:first-child { border-top: var(--rule); }
    .hackathon-layout { display: none; }
    .now-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .now-cell { min-height: 140px; padding: 12px; }
    .contact-panel { gap: var(--space-3); }
    .contact-panel h2 { font-size: 46px; }
    .contact-actions { flex-basis: 100%; }
    .site-footer { padding-block: 16px; }
    .site-footer span:last-child { flex-basis: 100%; }
  }
</style>
