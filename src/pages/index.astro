---
import Layout from '../layouts/Layout.astro';
import { getPosts } from '../lib/cms';
import { projects, hackathons } from '../lib/data';
const posts = await getPosts();
const latest = posts.slice(0, 3);
---

<Layout active="home">

<!-- ═══ HERO ═══════════════════════════════════════════════════════════════ -->
<div class="wrap">
  <section class="hero">
    <div class="hero-name r">
      <div class="line1">
        <span>John Carlo</span>
        <span class="hero-status" id="collab-status" style="cursor:pointer;" title="Click for a surprise!">
          <span class="hero-status-dot"></span>
          available for collab
        </span>
      </div>
      <span class="line2">Santos.</span>
    </div>
    <div class="hero-rule r d1"></div>
    <div class="hero-sub r d2">
      <p class="hero-desc">
        <strong>Data engineer</strong>, DevOps builder & hackathon competitor.<br/>
        BS Computer Engineering @ <strong>Bulacan State University</strong> · 2028.<br/>
        I build <span data-type="ETL pipelines.|agentic AI systems.|MCP servers.|tools for Filipino farmers.|things that ship."></span><span class="cursor"></span>
      </p>
      <div class="hero-actions" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <a href="#work"  class="btn btn-filled">Selected work</a>
        <a href="/book"  class="btn btn-outline">Book a call →</a>
        <span style="font-family:var(--mono);font-size:0.68rem;color:var(--ink-3);user-select:none;margin-left:8px;" class="hide-mobile">Press <kbd style="background:var(--s2);border:1px solid var(--b1);padding:2px 5px;border-radius:3px;color:var(--ink-2);">`</kbd> for console</span>
      </div>
    </div>
  </section>
</div>


<!-- ═══ SELECTED WORK ══════════════════════════════════════════════════════ -->
<section class="section" id="work">
  <div class="wrap">
    <div class="sec-label r">
      <span class="sec-num">01</span>
      <span class="sec-name">Selected Work</span>
      <span class="sec-rule"></span>
      <a href="https://github.com/kuyacarlo" target="_blank" rel="noopener"
         style="font-size:0.75rem;color:var(--ink-3);white-space:nowrap;text-decoration:underline;text-decoration-color:var(--b1);text-underline-offset:3px;">
        37 repos ↗
      </a>
    </div>

    <div class="project-grid">
      {projects.map((p, i) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class={`project-card r d${(i%4)+1}`}>
          <div class="proj-thumb">
            {p.img
              ? <img src={p.img} alt={p.name} loading="lazy" />
              : <div class="proj-placeholder"><span style="font-family:var(--mono);font-size:1.4rem;font-weight:600;opacity:0.85;">{p.name.slice(0, 2).toUpperCase()}</span></div>
            }
          </div>
          <div class="proj-body">
            <div class="proj-name">
              {p.name}
              {p.live && <span class="live-dot" title="Live"></span>}
            </div>
            <p class="proj-desc">{p.desc}</p>
            <div class="proj-tags">
              {p.tech.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>


<!-- ═══ HACKATHONS ═════════════════════════════════════════════════════════ -->
<section class="section" id="hackathons">
  <div class="wrap">
    <div class="sec-label r">
      <span class="sec-num">02</span>
      <span class="sec-name">Hackathons & Competitions</span>
      <span class="sec-rule"></span>
    </div>

    <div class="hack-list r d1">
      {hackathons.map(h => {
        const CardContent = (
          <>
            <div class="hack-place">{h.place}</div>
            <div class="hack-name">{h.name}</div>
            <span class="hack-proj">{h.proj}</span>
            <p class="hack-desc">{h.desc}</p>
          </>
        );
        return h.url ? (
          <a href={h.url} target="_blank" rel="noopener noreferrer" class="hack-item" style="display:block;text-decoration:none;color:inherit;transition:background 0.15s;">
            {CardContent}
          </a>
        ) : (
          <div class="hack-item">
            {CardContent}
          </div>
        );
      })}
    </div>
  </div>
</section>


<!-- ═══ ABOUT ══════════════════════════════════════════════════════════════ -->
<section class="section" id="about">
  <div class="wrap">
    <div class="sec-label r">
      <span class="sec-num">03</span>
      <span class="sec-name">About</span>
      <span class="sec-rule"></span>
    </div>

    <div class="about-grid">
      <div>
        <div class="prose r d1">
          <p>
            I'm <strong>Karlo</strong> — a generalist software engineer and student.
            My work spans ETL pipelines, containerized microservices, FastAPI backends,
            and agentic AI systems built with LangGraph + MCP.
          </p>
          <p>
            I gravitate toward tools that make other developers faster and projects
            that solve real problems for real Filipinos — pre-push security hooks,
            land-ownership systems for indigenous farmers, disaster-risk pipelines for LGUs.
          </p>
          <p>
            Currently CTO of <strong>Seekers Guild</strong> and Cybersecurity Associate at
            CS Society BulSU. Running <strong>Fedora Linux</strong>, learning Go,
            tinkering with a homelab. Check out <a href="/homelab">what's running →</a>
          </p>
          <p>
            Talks: <em>Git & GitHub Fundamentals</em> (CS Society BulSU),
            <em>Web Dev Basics</em> (Seekers Guild).
            Writing on <a href="https://dev.to/kuyacarlo" target="_blank" rel="noopener">dev.to ↗</a>
          </p>
        </div>

        <div class="r d2" style="margin-top:24px;">
          <p style="font-size:0.72rem;color:var(--ink-3);font-family:var(--mono);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;">Tech</p>
          <div class="skill-row">
            {["Python","Go","TypeScript","FastAPI","LangGraph","MCP","Docker","GitHub Actions","DuckDB","PostgreSQL","Supabase","GCP","AWS","Ansible","Linux","Bash"].map(t => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="about-aside r d2">
        <!-- Education -->
        <div class="aside-card">
          <div class="aside-head">
            <span class="aside-head-label">Education</span>
          </div>
          <div class="aside-row">
            <div>
              <div class="aside-val">BS Computer Engineering</div>
              <div class="aside-sub">Bulacan State University · Malolos</div>
            </div>
            <span class="aside-date">2028</span>
          </div>
        </div>

        <!-- Selected certs -->
        <div class="aside-card">
          <div class="aside-head">
            <span class="aside-head-label">Certifications</span>
          </div>
          {[
            ["Azure Data Fundamentals",      "Microsoft","May 2025"],
            ["Azure AI Services Workshop",   "Microsoft","May 2025"],
            ["Intro to Cybersecurity",       "Cisco","2025"],
            ["Cybersecurity Simulation",     "Mastercard","Apr 2025"],
          ].map(([name, issuer, date]) => (
            <div class="aside-row">
              <div>
                <div class="aside-val" style="font-size:0.78rem;">{name}</div>
                <div class="aside-sub">{issuer}</div>
              </div>
              <span class="aside-date">{date}</span>
            </div>
          ))}
        </div>

        <!-- Links -->
        <div class="aside-card">
          <div class="aside-head"><span class="aside-head-label">Find me</span></div>
          {[
            ["LinkedIn",  "linkedin.com/in/kuyacarlo", "https://linkedin.com/in/kuyacarlo"],
            ["GitHub",    "github.com/kuyacarlo",      "https://github.com/kuyacarlo"],
            ["dev.to",    "dev.to/kuyacarlo",          "https://dev.to/kuyacarlo"],
            ["Email",     "santos.karlo@outlook.com",  "mailto:santos.karlo@outlook.com"],
          ].map(([label, val, href]) => (
            <a href={href} target={label !== "Email" ? "_blank" : undefined} rel="noopener" class="aside-row" style="transition:background 0.15s;" onmouseover="this.style.background='var(--s2)'" onmouseout="this.style.background=''">
              <div>
                <div style="font-family:var(--mono);font-size:0.68rem;color:var(--ink-3);text-transform:uppercase;letter-spacing:0.08em;">{label}</div>
                <div class="aside-val" style="font-size:0.8rem;">{val}</div>
              </div>
              <span style="font-size:0.72rem;color:var(--ink-3);">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══ NOTES ══════════════════════════════════════════════════════════════ -->
<section class="section" id="notes">
  <div class="wrap">
    <div class="sec-label r">
      <span class="sec-num">04</span>
      <span class="sec-name">Notes</span>
      <span class="sec-rule"></span>
      <a href="/notes" style="font-size:0.75rem;color:var(--ink-3);white-space:nowrap;text-decoration:underline;text-decoration-color:var(--b1);text-underline-offset:3px;">all notes →</a>
    </div>

    <div class="r d1">
      {latest.map(p => (
        <a href={`/notes/${p.slug}`} class="note-row">
          <span class="note-date">{p.date}</span>
          <span class="note-title">{p.title}</span>
          <span class="note-arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>


<!-- ═══ HOMELAB TEASER ═════════════════════════════════════════════════════ -->
<section class="section" id="homelab-teaser">
  <div class="wrap">
    <div class="sec-label r">
      <span class="sec-num">05</span>
      <span class="sec-name">Homelab</span>
      <span class="sec-rule"></span>
    </div>

    <a href="/homelab" class="r d1" style="display:grid;grid-template-columns:1fr auto;align-items:center;gap:20px;border:1px solid var(--b1);border-radius:6px;padding:28px 32px;transition:background 0.15s,border-color 0.15s;" onmouseover="this.style.background='var(--s1)';this.style.borderColor='var(--b2)'" onmouseout="this.style.background='';this.style.borderColor='var(--b1)'">
      <div>
        <p style="font-size:0.92rem;font-weight:600;color:var(--ink);margin-bottom:6px;">Self-hosted services, hardware, and experiments</p>
        <p style="font-size:0.82rem;color:var(--ink-3);">Forgejo, Authentik, Vaultwarden, Grafana, n8n, Portainer — and whatever breaks next.</p>
        <div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;">
          {["Proxmox","Docker","Fedora","Authentik","Forgejo","Traefik"].map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <span style="font-size:1.1rem;color:var(--ink-3);">→</span>
    </a>
  </div>
</section>


<!-- ═══ FOOTER ══════════════════════════════════════════════════════════════ -->
<div class="wrap">
  <footer class="footer">
    <span>© 2026 John Carlo Santos</span>
    <span>Iterate fast, think deep, ship meaning.</span>
    <span><a href="/book" style="color:inherit;text-decoration:underline;text-decoration-color:var(--b2);text-underline-offset:3px;">book a call →</a></span>
  </footer>
</div>

</Layout>
