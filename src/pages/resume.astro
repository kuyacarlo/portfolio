---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import {
  TAGLINE,
  experience,
  talks,
  certifications,
  skillGroups,
  resumeWork,
  aboutBlurb,
} from '../lib/portfolio-data';

const pdfPath = '/resume/john-carlo-santos.pdf';
const hasStaticPdf = fs.existsSync(
  path.join(process.cwd(), 'public/resume/john-carlo-santos.pdf'),
);
---

<Layout
  active="resume"
  title="Resume — John Carlo Santos"
  description={`Resume for John Carlo Santos. ${TAGLINE}`}
>
  <div class="wrap" style="display:flex;flex-direction:column;min-height:100vh;">
    <article class="resume-page" style="flex:1;">

      <!-- Header -->
      <header class="resume-header r">
        <h1 class="resume-name">John Carlo Santos</h1>
        <p class="resume-tagline-line">
          <em class="resume-tagline-em">{TAGLINE}</em>
        </p>
        <p class="resume-contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span aria-hidden="true"> · </span>
          <a href={site.linkedinUrl} target="_blank" rel="noopener">linkedin.com/in/kuyacarlo</a>
          <span aria-hidden="true"> · </span>
          <a href={site.githubUrl} target="_blank" rel="noopener">github.com/kuyacarlo</a>
          <span aria-hidden="true"> · </span>
          <span>Bulacan, PH</span>
        </p>
        <div class="resume-actions resume-screen-only r d1">
          <button type="button" class="btn btn-outline" id="resume-print">⬇ Download PDF</button>
          {hasStaticPdf && (
            <a href={pdfPath} class="btn btn-outline" download>Static PDF</a>
          )}
        </div>
      </header>

      <!-- About -->
      <section class="resume-section r d1">
        <h2>About</h2>
        {aboutBlurb.map((p) => (
          <p class="resume-about-p">{p}</p>
        ))}
      </section>

      <!-- Skills -->
      <section class="resume-section r d1">
        <h2>Skills</h2>
        <div class="resume-skills-grid resume-screen-only">
          {skillGroups.map((g) => (
            <div class="resume-skill-col">
              <div class="resume-item-title">{g.label}</div>
              <div class="skill-row">
                {g.items.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
        <div class="resume-skills-harvard">
          {skillGroups.map((g) => (
            <p class="resume-skill-line">
              <strong>{g.label}:</strong> {g.items.join(", ")}
            </p>
          ))}
        </div>
      </section>

      <!-- Selected Projects -->
      <section class="resume-section r d2">
        <h2>Projects</h2>
        {resumeWork.map((p) => (
          <div class="resume-item">
            <div class="resume-item-head">
              <span class="resume-item-title">{p.name}</span>
              <span class="resume-item-meta">{p.category}</span>
            </div>
            <p>{p.desc}</p>
            {p.meta && <p class="resume-item-meta resume-item-submeta">{p.meta}</p>}
          </div>
        ))}
      </section>

      <!-- Experience -->
      <section class="resume-section r d2">
        <h2>Experience</h2>
        {experience.map((org) => (
          <div class="resume-item">
            <div class="resume-item-head">
              <span class="resume-item-title">{org.org}</span>
              <span class="resume-item-meta">
                {org.roles.length > 1
                  ? `${org.roles[org.roles.length - 1]?.dates.split('—')[0]?.trim()} — ${org.roles[0]?.dates.split('—')[1]?.trim() ?? 'present'}`
                  : org.roles[0]?.dates}
              </span>
            </div>
            {org.roles.map((role) => (
              <div class="resume-role">
                <div class="resume-role-title">{role.title}{org.roles.length > 1 ? ` · ${role.dates}` : ''}</div>
                {role.bullets && (
                  <ul>
                    {role.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        ))}
      </section>

      <!-- Leadership & Talks -->
      <section class="resume-section r d2">
        <h2>Leadership & Talks</h2>
        <ul class="resume-talk-list">
          {talks.map((t) => (
            <li><em>{t.title}</em> — {t.org}</li>
          ))}
        </ul>
      </section>

    </article>

    <footer class="footer resume-screen-only" style="margin-top:auto;">
      <span>© 2026 John Carlo Santos</span>
      <span>{TAGLINE}</span>
      <span><a href="/book" class="footer-link">let's talk →</a></span>
    </footer>
  </div>

  <script>
    document.getElementById('resume-print')?.addEventListener('click', () => window.print());
  </script>
</Layout>

<style>
  .resume-header {
    padding-top: 120px;
    padding-bottom: 40px;
    text-align: center;
  }
  .resume-name {
    font-size: clamp(2.8rem, 7vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 12px;
  }
  .resume-tagline-line {
    font-size: 1.05rem;
    color: var(--ink-2);
    margin-bottom: 16px;
  }
  .resume-tagline-em {
    font-style: italic;
    color: var(--ink);
    font-weight: 500;
  }
  .resume-contact {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    margin-bottom: 24px;
  }
  .resume-contact a {
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--b2);
  }
  .resume-actions {
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  /* Centered content on desktop */
  .resume-page {
    padding-top: 0;
    padding-bottom: 80px;
    max-width: 720px;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .resume-header {
      text-align: left;
      padding-top: 80px;
    }
    .resume-actions {
      justify-content: flex-start;
    }
    .resume-page {
      max-width: 100%;
    }
  }

  /* ─── Print: compact single-page CV ─────────────────────────────── */
  @media print {
    @page {
      size: A4;
      margin: 0.4in 0.55in;
    }

    .wrap {
      display: block !important;
      min-height: 0 !important;
    }
    .resume-page {
      max-width: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      font-family: "Times New Roman", Times, Georgia, serif;
      font-size: 10pt;
      line-height: 1.15;
      color: #000;
    }

    .resume-screen-only,
    .resume-actions,
    .footer {
      display: none !important;
    }

    .resume-header {
      padding: 0 0 8pt;
      text-align: center;
    }
    .resume-name {
      font-size: 24pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      line-height: 1.05;
      margin: 0 0 2pt;
    }
    .resume-tagline-line {
      font-size: 10pt;
      color: #000;
      margin: 0 0 2pt;
    }
    .resume-tagline-em {
      font-style: italic;
      font-weight: 400;
      color: #000;
    }
    .resume-contact {
      font-family: "Times New Roman", Times, Georgia, serif;
      font-size: 9pt;
      color: #000;
      margin: 0 0 8pt;
    }
    .resume-contact a {
      color: #000;
      text-decoration: none;
    }

    .resume-section {
      margin: 0 0 10pt;
      padding: 0;
      border-top: none;
      break-inside: avoid;
    }
    .resume-section h2 {
      font-family: "Times New Roman", Times, Georgia, serif;
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-bottom: 1px solid #000;
      padding-bottom: 2pt;
      margin: 0 0 4pt;
    }

    .resume-about-p {
      margin: 0 0 2pt;
      line-height: 1.15;
    }
    .resume-about-p:last-child { margin-bottom: 0; }

    .resume-item { margin: 0 0 6pt; }
    .resume-item:last-child { margin-bottom: 0; }
    .resume-item-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12pt;
      margin-bottom: 0;
    }
    .resume-item-title {
      font-size: 10.5pt;
      font-weight: 700;
      color: #000;
    }
    .resume-item-meta {
      font-family: "Times New Roman", Times, Georgia, serif;
      font-size: 9pt;
      font-style: italic;
      color: #000;
      white-space: nowrap;
    }
    .resume-item-submeta { display: none; }
    .resume-item p {
      margin: 0;
      line-height: 1.15;
    }

    .resume-role { margin: 2pt 0 0; }
    .resume-role-title {
      font-size: 10pt;
      font-style: italic;
      font-weight: 400;
      color: #000;
      margin: 0 0 1pt;
    }
    .resume-role ul {
      margin: 0 0 0;
      padding-left: 1.15em;
    }
    .resume-role li {
      line-height: 1.15;
      margin: 0;
    }

    .resume-skills-grid { display: none !important; }
    .resume-skills-harvard { display: block; }
    .resume-skill-line {
      margin: 0;
      line-height: 1.15;
    }
    .resume-skill-line strong { font-weight: 700; color: #000; }

    .resume-talk-list { margin: 0; padding: 0; }
    .resume-talk-list li {
      margin: 0;
      line-height: 1.15;
    }
    .resume-talk-list em {
      font-weight: 700;
      font-style: normal;
      color: #000;
    }

    .r { opacity: 1 !important; transform: none !important; }
  }

</style>
