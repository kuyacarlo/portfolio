---
import Layout from '../layouts/Layout.astro';
import { displayHost, site } from '../lib/site';

// Reasons people book, shown as a plain list (not choices). Length, time and contact details
// are picked in the Cal.com embed (site.bookingUrl): there is no slot API, so availability is
// never drawn here.
const reasons = ['Hackathon team', 'Data or DevOps role', 'Collaboration', 'Just talk shop'];
---
<Layout active="book" title="Let’s talk — John Carlo Santos" description="Choose a time to talk with John Carlo Santos. Times are shown in Manila time, UTC+8.">
  <main id="main">
    <section class="book-hero region">
      <h1>Pick one. I'll reply.</h1>
      <p class="book-lead">Pick a length and a time in the calendar, then leave your name and email. Times are in Manila, UTC+8.</p>
    </section>

    <div class="book-cells region">
      <section class="book-reasons" aria-labelledby="book-about">
        <h2 id="book-about" class="book-step">good reasons to book</h2>
        <ul>{reasons.map((reason) => <li>{reason}</li>)}</ul>
      </section>

      <section class="book-embed" aria-labelledby="book-when">
        <div class="book-step-row">
          <h2 id="book-when" class="book-step">pick a time</h2>
          <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">open {displayHost(site.bookingUrl)}</a>
        </div>
        <iframe src={site.bookingUrl} title="Choose a time to talk with John Carlo Santos" loading="lazy"></iframe>
      </section>
    </div>
  </main>
  <Fragment slot="footer"> · rather email? <a href={`mailto:${site.email}`}>{site.email}</a></Fragment>
</Layout>

<style>
  .book-hero { display: flex; flex-direction: column; gap: 20px; padding: var(--space-5) var(--gutter); }
  .book-hero h1 { margin: 0; font: var(--type-hero); line-height: .88; letter-spacing: var(--track-tight); }
  .book-lead { max-width: 640px; margin: 0; font: var(--type-lead); }

  /* Both cells carry a left rule; the -2px shift lays the first over the frame rule,
     so the embed never doubles a rule when it wraps under the reasons. */
  .book-cells { display: flex; flex-wrap: wrap; margin-left: calc(-1 * var(--rule-w)); }
  .book-reasons { flex: 1 1 360px; min-width: 0; border-left: var(--rule); }
  .book-embed { flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; border-left: var(--rule); }
  .book-step { margin: 0; font: 400 13px/1.4 var(--font-mono); text-transform: uppercase; }
  .book-reasons > .book-step, .book-step-row { padding: var(--space-2) var(--gutter); border-bottom: var(--rule); }
  .book-step-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; }
  .book-step-row a { font: 400 13px/1.4 var(--font-mono); }
  .book-reasons ul { margin: 0; padding: 0; list-style: none; }
  /* Plain text rows, not display-weight cells: these are reasons, not choices. */
  .book-reasons li { display: flex; align-items: center; min-height: 56px; padding: 0 var(--gutter); border-bottom: var(--rule); font: var(--type-body); }
  .book-embed iframe { display: block; flex: 1 0 auto; width: 100%; min-height: 720px; border: 0; background: var(--paper); }

  @media (max-width: 767px) {
    .book-hero { gap: var(--space-2); padding-block: var(--space-4); }
    .book-cells { margin-left: 0; }
    .book-reasons, .book-embed { flex-basis: 100%; border-left: 0; }
    .book-reasons li { min-height: 52px; }
    .book-embed iframe { min-height: 650px; }
  }
</style>
