---
import Layout from '../layouts/Layout.astro';
import homelab from '../data/homelab.json';
import { getCollection } from 'astro:content';
import { layerName } from '../lib/layers';

// The only public link this page may carry. Anything else in the data is dropped.
const PUBLIC_HOST = 'forge.kuyacarlo.dev';
const publicLink = (link?: string) => {
  if (!link) return null;
  try {
    const url = new URL(link);
    return url.protocol === 'https:' && url.host === PUBLIC_HOST ? { href: url.href, label: url.host } : null;
  } catch {
    return null;
  }
};

type Service = { name: string; note: string; link?: string };

const layerRows = Object.entries(homelab.services as Record<string, Service[]>)
  .map(([layer, services]) => ({ n: Number(layer), services }))
  .sort((a, b) => b.n - a.n);

// Only incidents with a published note link anywhere; the rest render as plain rows.
const publishedNotes = new Set(
  (await getCollection('notes', ({ data }) => !data.draft && !data.hide)).map((note) => note.id),
);
const incidents = homelab.incidents.map((incident) => ({
  ...incident,
  href: publishedNotes.has(incident.slug) ? `/notes/${incident.slug}` : null,
}));

const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout
  active="homelab"
  title="Homelab — John Carlo Santos"
  description="What runs on Andromeda, my small self-hosted server."
>
  <main id="main">
    <section class="region hl-hero" aria-labelledby="hl-title">
      <div class="hl-hero-main">
        <p class="hl-eyebrow">homelab</p>
        <h1 class="hl-title" id="hl-title">andromeda</h1>
        <p class="hl-lead">{homelab.intro}</p>
      </div>
      <dl class="hl-spec">
        {homelab.spec.map((item) => (
          <div class="hl-spec-row">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="region" aria-labelledby="hl-runs">
      <div class="region-head">
        <h2 id="hl-runs">What runs</h2>
      </div>
      {layerRows.map(({ n, services }) => (
        <div class="hl-layer">
          <span class="hl-badge">{pad(n)}</span>
          <div class="hl-services">
            <ul class="hl-service-grid" aria-label={layerName(n)}>
              {services.map((service) => {
                const link = publicLink(service.link);
                return (
                  <li class="hl-service">
                    <span class="hl-service-name">{service.name}</span>
                    <span class="hl-service-note">
                      {service.note}
                      {link && <> <a href={link.href} rel="noopener">{link.label}</a></>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
          <p class="hl-service-list">{services.map((service) => service.name).join(', ')}</p>
        </div>
      ))}
    </section>

    <section class="region" aria-labelledby="hl-broke">
      <div class="region-head">
        <h2 id="hl-broke">What broke</h2>
        <span class="hl-head-note">symptom → cause → fix</span>
      </div>

      <div class="hl-incidents">
        {incidents.map((incident) => (
          <article class="hl-incident">
            <h3 class="hl-incident-title">{incident.title}</h3>
            <p class="hl-incident-summary">{incident.summary}</p>
            {incident.href ? (
              <a class="hl-incident-link" href={incident.href}>read note<span class="sr-only">: {incident.title}</span></a>
            ) : (
              <span class="hl-incident-link" aria-hidden="true"></span>
            )}
          </article>
        ))}
      </div>

      <ul class="hl-incidents-phone">
        {incidents.map((incident) => (
          <li>
            {incident.href ? (
              <a class="hl-incident-row" href={incident.href}>
                <span class="hl-incident-row-title">{incident.title}</span>
                <span class="hl-arrow" aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="hl-incident-row">
                <span class="hl-incident-row-title">{incident.title}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  /* ── Hero: title cell + spec sheet ─────────────────────────────────── */
  .hl-hero { display: flex; flex-wrap: wrap; }
  .hl-hero-main {
    display: flex;
    flex: 999 1 560px;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5) var(--gutter);
  }
  .hl-title {
    margin: 0;
    font: var(--type-page-title);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .hl-eyebrow { margin: 0; font: 400 13px/1.4 var(--font-mono); text-transform: uppercase; }
  .hl-lead { max-width: 640px; margin: 0; font: var(--type-lead); }

  .hl-spec {
    display: flex;
    flex: 1 1 380px;
    flex-direction: column;
    margin: 0;
    border-left: var(--rule);
  }
  .hl-spec-row { display: flex; min-height: 52px; border-bottom: var(--rule); }
  .hl-spec-row:last-child { flex-grow: 1; border-bottom: 0; }
  .hl-spec dt,
  .hl-spec dd { display: flex; align-items: center; margin: 0; padding: 0 var(--space-2); }
  .hl-spec dt {
    box-sizing: content-box;
    flex: 0 0 132px;
    border-right: var(--rule);
    font: var(--type-label);
    text-transform: uppercase;
  }
  .hl-spec dd { font: 400 15px/1.5 var(--font-text); }

  /* ── What runs: full-height badge column, service cells edge to edge ── */
  .hl-layer { display: flex; border-bottom: var(--rule); }
  .hl-layer:last-child { border-bottom: 0; }
  .hl-badge {
    display: flex;
    flex: 0 0 72px;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    background: var(--ink);
    color: var(--paper);
    font: 400 14px/1 var(--font-mono);
  }
  /* The grid overhangs by one rule so the outer right and bottom rules are clipped:
     cells keep shared rules however the grid wraps. */
  .hl-services { flex: 1 1 0; min-width: 0; overflow: hidden; }
  .hl-service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin: 0 calc(-1 * var(--rule-w)) calc(-1 * var(--rule-w)) 0;
    padding: 0;
    list-style: none;
  }
  .hl-service {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--gutter);
    border-right: var(--rule);
    border-bottom: var(--rule);
  }
  .hl-service-name { font: 800 20px/1.2 var(--font-display); }
  .hl-service-note { font: 400 14px/1.5 var(--font-text); }
  .hl-service-list { display: none; }

  /* ── What broke ────────────────────────────────────────────────────── */
  .hl-head-note { color: var(--muted); font: 400 13px/1.4 var(--font-mono); }

  .hl-incident { display: flex; flex-wrap: wrap; border-bottom: var(--rule); }
  .hl-incident:last-child { border-bottom: 0; }
  .hl-incident-title { box-sizing: content-box; flex: 1 1 280px; margin: 0; padding: var(--space-3) var(--gutter); font: var(--type-card); }
  .hl-incident-summary { box-sizing: content-box; flex: 2 1 420px; margin: 0; padding: var(--space-3) var(--gutter); font: 400 16px/1.55 var(--font-text); }
  .hl-incident-link { box-sizing: content-box; flex: 0 0 160px; padding: var(--space-3) var(--gutter); font: 400 14px/1.4 var(--font-mono); }

  .hl-incidents-phone { display: none; margin: 0; padding: 0; list-style: none; }

  /* ── Phone ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .hl-hero { display: block; }
    .hl-hero-main {
      gap: var(--space-2);
      padding: var(--space-4) var(--gutter);
      border-bottom: var(--rule);
    }
    .hl-eyebrow { font-size: 12px; }

    .hl-spec { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-left: 0; }
    .hl-spec-row {
      display: block;
      min-width: 0;
      min-height: 0;
      padding: 12px var(--gutter);
    }
    .hl-spec-row:nth-child(odd) { border-right: var(--rule); }
    .hl-spec-row:last-child { border-bottom: 0; }
    .hl-spec-row:nth-last-child(2):nth-child(odd) { border-bottom: 0; }
    .hl-spec dt,
    .hl-spec dd { display: block; padding: 0; border: 0; }
    .hl-spec dt { font-size: 11px; }
    .hl-spec dd { margin-top: 4px; font-size: 15px; }

    .hl-badge { flex-basis: 48px; min-height: 0; font-size: 13px; }
    .hl-services { display: none; }
    .hl-service-list {
      display: block;
      flex: 1 1 auto;
      min-width: 0;
      margin: 0;
      padding: 14px var(--gutter);
      font: 400 15px/1.5 var(--font-text);
    }

    .hl-head-note { display: none; }
    .hl-incidents { display: none; }
    .hl-incidents-phone { display: block; }
    .hl-incidents-phone li + li { border-top: var(--rule); }
    .hl-incident-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: var(--touch);
      padding: var(--space-2) var(--gutter);
      color: var(--ink);
      text-decoration: none;
    }
    a.hl-incident-row:hover .hl-incident-row-title { text-decoration: underline; }
    .hl-incident-row-title { font: 800 18px/1.2 var(--font-display); }
    .hl-arrow { font: 400 18px/1 var(--font-mono); }
  }
</style>
