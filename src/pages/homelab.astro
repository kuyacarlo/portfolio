---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';

/** Catalog of what's hosted. Live up/down comes from Uptime Kuma only. */
const services = [
  { name: "Forgejo",     desc: "Self-hosted Git. Mirrors to GitHub.", url: "https://forge.kuyacarlo.dev" },
  { name: "Authentik",   desc: "Identity provider — SSO for all services." },
  { name: "Vaultwarden", desc: "Bitwarden-compatible password server.", url: "https://vault.kuyacarlo.dev" },
  { name: "Traefik",     desc: "Reverse proxy + auto TLS via Let's Encrypt." },
  { name: "Portainer",   desc: "Container management UI." },
  { name: "Grafana",     desc: "Monitoring dashboard — Prometheus + Loki." },
  { name: "Prometheus",  desc: "Metrics scraping from all containers." },
  { name: "Loki",        desc: "Log aggregation. Tailed by Promtail." },
  { name: "n8n",         desc: "Workflow automation — webhooks, notifications." },
  { name: "Uptime Kuma", desc: "Public status page for hosted services.", url: site.statusUrl },
  { name: "Forgejo CI",  desc: "Self-hosted CI runner. Mostly linting + tests." },
  { name: "Netbird",     desc: "Mesh VPN — connect lab hosts from anywhere." },
];

const hardware = [
  ["Machine",  "ThinkCentre M710q-N000"],
  ["Storage",  "512 GB SSD OS · 2 TB HDD data (1×1 TB + 2×500 GB)"],
  ["OS",       "Fedora Server"],
  ["VPN",      "Netbird"],
];

const stack = [
  ["Container runtime", "Podman (rootless)"],
  ["Secrets",           "Vaultwarden + env files"],
  ["DNS",               "Pi-hole for ad blocking"],
  ["Monitoring",        "Grafana + Prometheus + Loki + Uptime Kuma"],
  ["CI/CD",             "Forgejo Actions"],
  ["Auth",              "Authentik SSO — OAuth2 proxy in front of services"],
];

const statusApi = `${site.statusUrl.replace(/\/$/, "")}/api/status-page/default`;
const heartbeatApi = `${site.statusUrl.replace(/\/$/, "")}/api/status-page/heartbeat/default`;
---

<Layout active="homelab" title="Homelab — John Carlo Santos" navStickyId="services">
<div class="wrap">

  <!-- header -->
  <section style="padding-top:120px;padding-bottom:60px;">
    <h1 class="r" style="font-size:clamp(2.8rem,7vw,6rem);font-weight:700;letter-spacing:-0.04em;line-height:0.95;margin-bottom:20px;">
      Home<br/><span style="color:var(--ink-3);">lab.</span>
    </h1>
    <p class="r d1" style="font-size:0.92rem;color:var(--ink-2);max-width:520px;line-height:1.75;margin-bottom:32px;">
      One machine. Twelve services. Constant tinkering.<br/>
      Everything self-hosted, everything on Podman, everything monitored.
    </p>
    <a href={site.statusUrl} target="_blank" rel="noopener"
       class="avail-badge r d2" id="uptime-badge">
      <span class="hero-status-dot"></span>
      <span id="uptime-text">live status → Uptime Kuma</span>
    </a>
  </section>

  <!-- Services grid -->
  <section class="section" id="services">
    <div class="sec-label r">
      <span class="sec-num">01</span>
      <span class="sec-name">Services</span>
      <span class="sec-rule"></span>
      <a href={site.statusUrl} target="_blank" rel="noopener" class="sec-link" id="services-summary">
        via Uptime Kuma ↗
      </a>
    </div>
    <div class="homelab-grid r d1">
      {services.map(s => (
        s.url ? (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="service-card" data-service-name={s.name.toLowerCase()}>
            <div class="service-status">
              <span class="status-dot status-unknown"></span>
              <span class="status-text" style="font-family:var(--mono);font-size:0.68rem;color:var(--ink-3);">—</span>
            </div>
            <div class="service-name">{s.name}</div>
            <div class="service-desc">{s.desc}</div>
          </a>
        ) : (
          <div class="service-card" data-service-name={s.name.toLowerCase()}>
            <div class="service-status">
              <span class="status-dot status-unknown"></span>
              <span class="status-text" style="font-family:var(--mono);font-size:0.68rem;color:var(--ink-3);">—</span>
            </div>
            <div class="service-name">{s.name}</div>
            <div class="service-desc">{s.desc}</div>
          </div>
        )
      ))}
    </div>
    <p class="sec-count r" style="margin-top:16px;">
      Dots sync from <a href={site.statusUrl} target="_blank" rel="noopener" class="footer-link">Uptime Kuma</a> when a monitor exists. Unmonitored services stay as —.
    </p>
  </section>

  <script define:vars={{ statusApi, heartbeatApi, statusUrl: site.statusUrl }}>
    document.addEventListener('DOMContentLoaded', async () => {
      const cards = document.querySelectorAll('.service-card');
      const summary = document.getElementById('services-summary');
      const setCard = (card, state, label) => {
        const dot = card.querySelector('.status-dot');
        const text = card.querySelector('.status-text');
        if (dot) dot.className = `status-dot status-${state}`;
        if (text) text.textContent = label;
      };

      try {
        const [pageRes, hbRes] = await Promise.all([
          fetch(statusApi),
          fetch(heartbeatApi),
        ]);
        if (!pageRes.ok || !hbRes.ok) throw new Error('status api unavailable');

        const page = await pageRes.json();
        const hb = await hbRes.json();
        const heartbeats = hb.heartbeatList || {};

        const monitors = [];
        (page.publicGroupList || []).forEach((group) => {
          (group.monitorList || []).forEach((m) => monitors.push(m));
        });

        let up = 0;
        let tracked = 0;

        cards.forEach((card) => {
          const name = (card.getAttribute('data-service-name') || '').toLowerCase();
          // Skip matching the status page itself as a generic catch-all
          const monitor = monitors.find((m) => {
            const mn = (m.name || '').toLowerCase();
            return mn === name;
          });

          if (!monitor) {
            setCard(card, 'unknown', '—');
            return;
          }

          tracked++;
          const beats = heartbeats[String(monitor.id)] || [];
          const latest = beats.length ? beats[beats.length - 1] : null;
          // Uptime Kuma: 1 = up, 0 = down, 2 = pending, 3 = maintenance
          const isUp = latest ? latest.status === 1 : false;
          if (isUp) up++;
          setCard(card, isUp ? 'up' : 'down', isUp ? 'up' : 'down');
        });

        if (summary) {
          summary.textContent = tracked
            ? `${up}/${tracked} monitored ↗`
            : 'via Uptime Kuma ↗';
          summary.setAttribute('href', statusUrl);
        }
      } catch (e) {
        console.warn('Could not update live status', e);
        if (summary) summary.textContent = 'status page ↗';
      }
    });
  </script>

  <!-- Hardware -->
  <section class="section">
    <div class="sec-label r">
      <span class="sec-num">02</span>
      <span class="sec-name">Hardware</span>
      <span class="sec-rule"></span>
    </div>
    <div class="hw-grid r d1">
      {hardware.map(([label, val]) => (
        <div class="hw-row">
          <span class="hw-label">{label}</span>
          <span class="hw-val">{val}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Stack decisions -->
  <section class="section">
    <div class="sec-label r">
      <span class="sec-num">03</span>
      <span class="sec-name">Stack decisions</span>
      <span class="sec-rule"></span>
    </div>
    <div class="r d1" style="border:1px solid var(--b1);border-radius:6px;overflow:hidden;">
      {stack.map(([label, val], i) => (
        <div style={`display:grid;grid-template-columns:180px 1fr;gap:16px;padding:14px 20px;border-bottom:${i < stack.length-1 ? '1px solid var(--b1)' : 'none'};font-size:0.83rem;`}>
          <span style="font-family:var(--mono);color:var(--ink-3);font-size:0.72rem;padding-top:2px;">{label}</span>
          <span style="color:var(--ink-2);">{val}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <span>© 2026 John Carlo Santos</span>
  </footer>

</div>
</Layout>
