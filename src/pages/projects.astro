---
import Layout from '../layouts/Layout.astro';
import CoverageStrip from '../components/CoverageStrip.astro';
import { layers } from '../lib/layers';
import projectContent from '../data/projects.json';

type Links = { source?: string; live?: string; internal?: string };
const projects = projectContent.projects.map((project) => ({ ...project, links: project.links as Links }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout active="projects" title="Projects — John Carlo Santos" description="Software, systems, and open source projects by John Carlo Santos.">
  <main id="main">
    <section class="region projects-hero" aria-labelledby="projects-title">
      <div class="projects-title-copy">
        <p class="eyebrow">01 Selected work / all</p>
        <h1 id="projects-title">Projects</h1>
      </div>
      <ul class="project-layer-grid" aria-label="Project layers">
        {[...layers].reverse().map((layer) => (
          <li><b>{pad(layer.n)}</b><span>{layer.name}</span></li>
        ))}
      </ul>
    </section>

    <section class="region" aria-label="All projects">
      <div class="project-table" role="table" aria-label="Projects">
        <div class="project-row project-head" role="row">
          <span role="columnheader">project</span>
          <span role="columnheader">what it is</span>
          <span class="project-layers" role="columnheader">{layers.map((layer) => <span>{pad(layer.n)}</span>)}</span>
          <span role="columnheader">links</span>
        </div>
        {projects.map((project) => (
          <article class="project-row" role="row">
            <h2 role="cell">{project.name}</h2>
            <p role="cell">{project.description}</p>
            <span class="project-coverage" role="cell"><CoverageStrip layers={project.layers} /></span>
            <span class="project-links" role="cell">
              {project.links.source && <a href={project.links.source} target="_blank" rel="noopener noreferrer">source</a>}
              {project.links.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">live</a>}
              {project.links.internal && <a href={project.links.internal}>homelab</a>}
            </span>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .projects-hero { display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--space-4); padding: var(--space-5) var(--gutter); }
  .projects-title-copy { display: flex; flex: 1 1 500px; flex-direction: column; justify-content: center; gap: var(--space-2); min-width: 0; }
  .eyebrow { margin: 0; color: var(--muted); font: var(--type-label); text-transform: uppercase; }
  h1 { margin: 0; font: var(--type-page-title); letter-spacing: var(--track-tight); }
  .projects-hero > ul.project-layer-grid { display: grid; flex: 0 1 594px; width: 594px; max-width: 100%; grid-auto-flow: column; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: 40px 40px; align-self: center; margin: 0; padding: 0; border: var(--rule); list-style: none; font: 400 12px/1 var(--font-mono); }
  .project-layer-grid li { display: contents; }
  .project-layer-grid li > b, .project-layer-grid li > span { display: flex; align-items: center; justify-content: center; min-width: 0; padding: 0 3px; border-right: var(--rule); border-bottom: var(--rule); text-align: center; overflow-wrap: anywhere; }
  .project-layer-grid li > b { border-right-color: var(--paper); background: var(--ink); color: var(--paper); font-weight: 700; }
  .project-layer-grid li:last-child > b, .project-layer-grid li:last-child > span { border-right: 0; }
  .project-row { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(260px, 1.5fr) 216px minmax(130px, .7fr); align-items: stretch; border-bottom: var(--rule); }
  .project-row:last-child { border-bottom: 0; }
  .project-row > * { min-width: 0; margin: 0; padding: var(--space-2) var(--gutter); }
  .project-head { color: var(--muted); font: var(--type-label); text-transform: uppercase; }
  .project-head > * { padding-block: 10px; }
  .project-head .project-layers { display: grid; grid-template-columns: repeat(6, 1fr); text-align: center; }
  .project-row h2 { font: var(--type-card); overflow-wrap: anywhere; }
  .project-row p { font: var(--type-body); }
  .project-coverage { display: flex; padding: 0; }
  .project-coverage :global(.coverage) { width: 100%; height: 48px; gap: 2px; border: 0; }
  .project-coverage :global(.coverage-cell) { border: var(--rule); }
  .project-coverage :global(.coverage-cell + .coverage-cell) { border-left: var(--rule); }
  .project-links { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 12px; font: 400 14px/1.4 var(--font-mono); }
  @media (min-width: 768px) and (max-width: 1023px) {
    .project-row { grid-template-columns: minmax(130px, 1fr) minmax(180px, 1.5fr) 160px minmax(90px, .7fr); }
    .project-row > * { padding-inline: var(--space-2); }
  }
  @media (max-width: 767px) {
    .projects-hero { flex-direction: column; gap: var(--space-3); padding-block: var(--space-4); }
    .projects-hero > ul.project-layer-grid { flex: none; width: 100%; grid-template-rows: 40px 40px; }
    .project-head { display: none; }
    .project-row { grid-template-columns: 1fr; gap: 0; padding: var(--space-2) 0; }
    .project-row > * { padding: var(--space-1) var(--gutter); }
    .project-row h2 { font-size: 20px; }
    .project-coverage :global(.coverage) { height: 14px; min-height: 14px; }
    .project-links { min-height: 44px; align-items: center; }
  }
</style>
