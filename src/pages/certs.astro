---
import Layout from '../layouts/Layout.astro';
import CertCard, { type Cert } from '../components/CertCard.astro';
import certData from '../data/certs.json';

// Only certs the reader can verify are published (HANDOFF §5, §9.2). No placeholder cards.
const verifiedCerts = (certData.certs as Cert[]).filter((cert) => Boolean(cert.verifyUrl));
---

<Layout
  active="certs"
  title="Certs — John Carlo Santos"
  description="Verified certifications and credentials for John Carlo Santos."
>
  <main id="main">
    <section class="certs-hero region">
      <p class="eyebrow">certs</p>
      <h1>Certs</h1>
      <p class="certs-lead">Each one links to the issuer, so you don't have to take my word for it.</p>
    </section>

    {verifiedCerts.length > 0 && (
      <section class="certs-grid region" aria-label="Certifications">
        {verifiedCerts.map((cert) => <CertCard cert={cert} />)}
      </section>
    )}
  </main>
</Layout>

<style>
  .certs-hero { display: flex; flex-direction: column; gap: 20px; padding: var(--space-5) var(--gutter); }
  .certs-hero .eyebrow { margin: 0; color: var(--ink); font: 400 13px/1.4 var(--font-mono); letter-spacing: 0; }
  .certs-hero h1 { margin: 0; font: var(--type-page-title); letter-spacing: -.04em; text-transform: uppercase; }
  .certs-lead { max-width: 640px; margin: 0; font: var(--type-lead); }
  /* Cards overlap by one rule (-2px) so neighbours share a single border; overflow clips the outer edge. */
  .certs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); overflow: hidden; }

  @media (max-width: 767px) {
    .certs-hero { gap: var(--space-2); padding-block: var(--space-4); }
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>
