---
import NoteLayout from '../../layouts/NoteLayout.astro';
import { getCollection, render } from 'astro:content';
import { getPosts } from '../../lib/cms';

export async function getStaticPaths() {
  const entries = await getCollection('notes', (e: any) => {
    const hidden = e.data.draft || e.data.hide;
    // In dev, still build hidden notes so you can preview at their URL.
    return import.meta.env.DEV ? true : !hidden;
  });
  return entries.map((entry: any) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, tags } = entry.data;
const minutes = Math.max(1, Math.ceil((entry.body || '').split(/\s+/).length / 200));
const body = entry.body || '';
const hasMath = /\$\$[\s\S]+?\$\$|\$[^$\n]+\$|\\begin\{/.test(body);
const hasTikz = /```(?:tikz|circuitikz)/i.test(body);
const hasMermaid = /```mermaid/i.test(body);

const slug = entry.id.replace(/\.md$/, '');
const posts = await getPosts(); // newest → oldest
const idx = posts.findIndex((p) => p.slug === slug);
const newer = idx > 0 ? posts[idx - 1] : null;
const older = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : null;
---

<NoteLayout
  title={`${title} — John Carlo Santos`}
  description={entry.data.desc}
  noteTitle={title}
  hasMath={hasMath}
  hasTikz={hasTikz}
  hasMermaid={hasMermaid}
>
<div class="wrap">

  <article class="note-article">
    <div class="note-tags r">
      {tags.map((t: string) => <span class="tag">{t}</span>)}
    </div>

    <h1 class="r d1" id="note-title">{title}</h1>
    <div class="note-meta r d2">
      <time datetime={date}>{date}</time>
      <span class="note-meta-sep">·</span>
      <span>{minutes} min read</span>
    </div>

    <div class="body r d3">
      <Content />
    </div>

    <nav class="note-footer" aria-label="Note pagination">
      <div class="note-footer-side note-footer-prev">
        {newer ? (
          <a class="note-footer-link" href={`/notes/${newer.slug}`}>
            <span class="note-footer-arrow" aria-hidden="true">←</span>
            <span class="note-footer-link-title">{newer.title}</span>
          </a>
        ) : null}
      </div>
      <div class="note-footer-center">
        <a href="/notes">all notes</a>
      </div>
      <div class="note-footer-side note-footer-next">
        {older ? (
          <a class="note-footer-link" href={`/notes/${older.slug}`}>
            <span class="note-footer-link-title">{older.title}</span>
            <span class="note-footer-arrow" aria-hidden="true">→</span>
          </a>
        ) : null}
      </div>
    </nav>
  </article>

</div>
</NoteLayout>
