---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/cms';
const posts = await getPosts();
---

<Layout active="notes" title="Notes — John Carlo Santos">
<div class="wrap">

  <section style="padding-top:120px;padding-bottom:48px;">
    <h1 class="r" style="font-size:clamp(2.2rem,6vw,4.5rem);font-weight:700;letter-spacing:-0.04em;margin-bottom:10px;">Notes.</h1>
    <p class="r d1" style="font-size:0.88rem;color:var(--ink-2);max-width:440px;">
      Occasional writing on data engineering, DevOps, MCP, and building things in the Philippines.
    </p>
  </section>

  <div class="r d2" style="padding-bottom:80px;">
    {posts.length === 0 && (
      <p style="font-size:0.88rem;color:var(--ink-3);padding:24px 0;border-top:1px solid var(--b1);">No notes yet.</p>
    )}
    {posts.map(p => (
      <a href={`/notes/${p.slug}`} class="note-row">
        <span class="note-date">{p.date}</span>
        <span class="note-title">{p.title}</span>
        <span class="note-arrow">↗</span>
      </a>
    ))}
  </div>

  <footer class="footer">
    <span>© 2026 John Carlo Santos</span>
  </footer>

</div>
</Layout>
