---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/cms';
import CoverageStrip from '../../components/CoverageStrip.astro';
import { layers } from '../../lib/layers';

const posts = await getPosts();
---
<Layout active="notes" title="Notes — John Carlo Santos" description="Things I broke, fixed, or figured out. Written so the next person, usually me, doesn't have to start from zero.">
  <main id="main" class="notes-page page">
    <header class="notes-hero">
      <p class="eyebrow">writing / field notes</p>
      <h1>NOTES</h1>
      <p>Things I broke, fixed, or figured out. Written so the next person, usually me, doesn't have to start from zero.</p>
    </header>

    <section class="notes-index" aria-label="Notes by layer">
      <div class="layer-filter" role="group" aria-label="Filter notes by layer">
        <button type="button" data-layer-filter="all" aria-pressed="true">ALL</button>
        {layers.map((layer) => <button type="button" data-layer-filter={layer.n} aria-pressed="false">{String(layer.n).padStart(2, '0')}</button>)}
      </div>
      <div class="notes-list" aria-live="polite">
        {posts.map((post) => (
          <a class="note-list-item" href={`/notes/${post.slug}`} data-note-layers={post.layers.join(',')}>
            <span class="note-list-date">{post.date}</span>
            <span class="note-list-copy">
              <strong>{post.title}</strong>
              {post.desc && <span>{post.desc}</span>}
            </span>
            <CoverageStrip layers={post.layers} />
          </a>
        ))}
        <p class="notes-empty" hidden>Nothing at this layer yet.</p>
        {posts.length === 0 && <p class="notes-empty">No notes yet.</p>}
      </div>
    </section>
    <footer class="site-footer"><span>© {new Date().getFullYear()} John Carlo Santos</span><span>Iterate fast, think deep, ship meaning.</span></footer>
  </main>
</Layout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-layer-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-note-layers]')];
  const empty = document.querySelector<HTMLElement>('.notes-empty');
  const params = new URLSearchParams(location.search);
  const initial = params.get('layer');
  const applyFilter = (layer: string, push = false) => {
    let visible = 0;
    for (const item of items) {
      const matches = layer === 'all' || (item.dataset.noteLayers ?? '').split(',').includes(layer);
      item.hidden = !matches;
      if (matches) visible += 1;
    }
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.layerFilter === layer)));
    if (empty) empty.hidden = visible !== 0;
    if (push) {
      const next = new URL(location.href);
      if (layer === 'all') next.searchParams.delete('layer');
      else next.searchParams.set('layer', layer);
      history.pushState({}, '', next);
    }
  };
  const validInitial = initial && buttons.some((button) => button.dataset.layerFilter === initial) ? initial : 'all';
  applyFilter(validInitial);
  buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.layerFilter ?? 'all', true)));
  window.addEventListener('popstate', () => applyFilter(new URLSearchParams(location.search).get('layer') ?? 'all'));
</script>

<style>
  .notes-hero { padding-block: clamp(48px, 8vw, 104px); border-bottom: var(--rule); }
  .notes-hero h1 { margin: 0 0 var(--space-3); font: var(--type-page-title); letter-spacing: -.04em; }
  .notes-hero > p:last-child { max-width: 720px; margin: 0; font: var(--type-lead); }
  .notes-index { padding-block: var(--space-4); }
  .layer-filter { display: flex; overflow-x: auto; border: var(--rule); margin-bottom: var(--space-4); }
  .layer-filter button { flex: 0 0 auto; min-width: 56px; min-height: 48px; padding: 0 14px; border: 0; border-right: var(--rule); background: var(--paper); font: var(--type-label); }
  .layer-filter button:last-child { border-right: 0; }
  .layer-filter button[aria-pressed="true"] { color: var(--paper); background: var(--ink); }
  .note-list-item { display: grid; grid-template-columns: 120px minmax(0,1fr) 216px; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-top: var(--rule); color: var(--ink); text-decoration: none; }
  .note-list-date { color: var(--muted); font: var(--type-label); }
  .note-list-copy { display: grid; gap: 6px; }
  .note-list-copy strong { font: var(--type-card); }
  .note-list-copy > span { font: var(--type-body); }
  .notes-empty { margin: 0; padding: var(--space-3); border: var(--rule); font: var(--type-label); }
  .notes-page .site-footer { margin-inline: calc(-1 * var(--gutter)); }
  @media (max-width: 767px) {
    .notes-hero { padding-block: var(--space-5); }
    .notes-hero > p:last-child { font-size: 16px; }
    .note-list-item { grid-template-columns: minmax(0,1fr); gap: 8px; }
    .note-list-item :global(.coverage) { width: 100%; height: 14px; }
    .note-list-date { font-size: 11px; }
  }
</style>
